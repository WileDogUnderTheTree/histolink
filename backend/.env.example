# =============================================================================
# 史脉 · 后端环境变量示例（V1.0.1 / TC-10）
# -----------------------------------------------------------------------------
# 复制本文件为 backend/.env 后填入真实值（.env 已被 .gitignore 忽略，不会入库）。
#
#   Copy-Item backend/.env.example backend/.env   # PowerShell
#   # 然后编辑 backend/.env，填入 MODELSCOPE_API_KEY
#
# 安全约定：真实 key 只放 backend/.env 或系统环境变量，不要写进代码 / 文档 / 提交记录。
# =============================================================================

# ModelScope 推理服务（OpenAI 兼容）的访问密钥；必填。
MODELSCOPE_API_KEY=

# 服务地址；默认即 ModelScope 官方推理端点。
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 模型名；TC-10 实测使用 Qwen3.5-35B-A3B（支持 JSON / tool calling / SSE / 思考开关）。
MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B

# 单次调用超时（秒，1–300），默认 30。
LLM_TIMEOUT_SECONDS=30

# 可选：设为 0 可关闭 /api/agent/ping_llm 探测端点（公网分享时建议关闭）。
ENABLE_LLM_PROBE=1
