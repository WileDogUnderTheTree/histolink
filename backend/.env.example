# =============================================================================
# 史脉 · 后端环境变量示例（V1.0.7 发版基线 / 本地 Ollama 流式直答 + 日志脱敏）
# -----------------------------------------------------------------------------
# 复制本文件为 backend/.env 后填入真实值（.env 已被 .gitignore 忽略，不会入库）。
#
#   Copy-Item backend/.env.example backend/.env   # PowerShell
#
# 两套可用配置：
#   A. 云端 ModelScope（OpenAI 兼容）——真实 key，模型填 Qwen/...；
#   B. 本地 Ollama（OpenAI 兼容，http://localhost:11434/v1）——api_key 随便填。
#      本地模式必须确认 `ollama serve` 在跑、模型已 pull；详见
#      docs/V1.0.6.2-本地Ollama流式接入与日志脱敏.md。
#
# 安全约定：真实 key 只放 backend/.env 或系统环境变量，不要写进代码 / 文档 / 提交记录。
# =============================================================================

# OpenAI 兼容服务的访问密钥；必填（本地 Ollama 填 ollama 即可，不会校验）。
MODELSCOPE_API_KEY=

# 服务地址；云端默认 ModelScope 官方推理端点，本地填 http://localhost:11434/v1。
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# 主模型；支持 JSON / tool calling / SSE / 思考开关。
# 前端模型切换窗口的数据源是 GET /api/agent/models，选项即本文件的主模型 + 备用模型。
# 本地 Ollama 示例：hf.co/mradermacher/XiaoHong-v1-GGUF:Q4_K_M
MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B

# 备用（轻量）模型；与主模型同名时自动禁用降级（本地只有一个模型时就这样配置）。
MODELSCOPE_FALLBACK_MODEL=Qwen/Qwen3.5-8B-Instruct

# 可选：模型切换窗口的展示名（真实模型名太长时用；请求上游仍用上面的 MODELSCOPE_MODEL）。
# HF GGUF 模型名会自动缩写（如 hf.co/.../XiaoHong-v1-GGUF:Q4_K_M → XiaoHong-v1）。
# LLM_MODEL_DISPLAY_NAME=XiaoHong-v1
# LLM_FALLBACK_MODEL_DISPLAY_NAME=

# 单次调用超时（秒，1–300），默认 30；本地 4060 跑 8B 建议 120+。
LLM_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# V1.0.6.2 思考模式（流式直答 / 证据管线共用）
# -----------------------------------------------------------------------------
# none / auto / low / medium / high / 留空（不传该参数）。
# 注意：Ollama 的 Qwen3 模板默认开启思考；XiaoHong-v1 不输出  收尾标签，
# 开启思考时企业兼容层会把全部内容放进 reasoning、content 为空，因此本地推荐 none。
# auto（默认）：base_url 是本机回环地址时自动按 none 处理，云端不传该参数。
LLM_REASONING_EFFORT=auto

# -----------------------------------------------------------------------------
# V1.0.6.2 流式直答（POST /api/agent/chat_stream，SSE）
# -----------------------------------------------------------------------------
# 流式请求超时（秒，10–900），默认 300。
LLM_STREAM_TIMEOUT_SECONDS=300
# 单次最大输出 token（64–8192），默认 2048。
LLM_STREAM_MAX_TOKENS=2048
# V1.0.6.2 专项修复：采样温度（0.0–1.5），默认 0.3。
# 旧版硬编码 0.7 会让本地 8B 模型频繁陷入「结论 → 依据一/二/三 → 结论」重复循环；
# 0.2–0.4 明显收敛，过低则答案趋于模板化。
LLM_STREAM_TEMPERATURE=0.3
# 是否开放流式直答端点（1 开 / 0 关；公网分享时建议关闭）。
ENABLE_STREAM_CHAT=1

# -----------------------------------------------------------------------------
# V1.0.6.2 日志脱敏（保护用户隐私）
# -----------------------------------------------------------------------------
# 1（默认）= 启用密钥 / Bearer token 脱敏；0 = 关闭。
LOG_REDACTION=1
# 1 = 额外脱敏邮箱 / 手机号 / 身份证号（默认 0，避免影响排查）。
# LOG_REDACT_PII=0

# 可选：设为 0 可关闭 /api/agent/ping_llm 探测端点（公网分享时建议关闭）。
ENABLE_LLM_PROBE=1

# -----------------------------------------------------------------------------
# 会话历史库 + 自动化测试隔离（V1.0.6.2 收尾）
# -----------------------------------------------------------------------------
# 用户正式历史 SQLite 路径；默认 backend/data/sessions.v1.sqlite。
# 清空历史用：cd backend; .\.venv\Scripts\python scripts\clean_sessions.py --yes
# SESSION_DB_PATH=backend/data/sessions.v1.sqlite

# 自动化测试 / 探针会话（test_ / e2e_ / pytest_ / smoke_ / probe- 前缀）使用的独立测试库；
# 默认 :memory:（不落盘）。E2E 可传 `/ask?session_id=e2e_xxx` 使用测试会话，
# 这类会话**绝不会**写入上面的用户正式历史，也不出现在侧边栏。
# SESSION_TEST_DB_PATH=:memory:

# 自定义「可丢弃会话」前缀（逗号分隔；留空使用默认前缀列表）。
# SESSION_DISPOSABLE_PREFIXES=test_,e2e_,pytest_,smoke_,probe-

# -----------------------------------------------------------------------------
# V1.0.8 点赞计数（左下角点赞悬浮组件）
# -----------------------------------------------------------------------------
# 点赞计数 JSON 文件路径；默认 backend/data/likes.json（文件不存在时自动创建 {"count":0}）。
# 自动化测试 / 探针可设为 :memory:（不落盘）。
# LIKES_PATH=backend/data/likes.json

# -----------------------------------------------------------------------------
# RAG 混合检索（V1.0.5）
# -----------------------------------------------------------------------------
# 向量库持久化目录；默认 backend/data/chroma_db（由 scripts/ingest_rag.py 生成，已 gitignore）。
# RAG_CHROMA_DIR=

# embedding provider：auto（默认：ModelScope API → 本地 fastembed → 离线 hash）
#                    modelscope / local / hash
RAG_EMBEDDING_PROVIDER=auto

# 可选：HuggingFace 下载镜像（默认已使用 https://hf-mirror.com）。
# HF_ENDPOINT=https://hf-mirror.com